# 知识库文档服务环境变量示例。
#
# 使用方法：将本文件复制为同目录的 `.env` 后再启动服务：
#   Copy-Item .env.example .env
# Pydantic Settings 会在服务启动时读取 `.env`。Docker Compose 会加载本示例并覆盖容器内服务地址；
# `.env` 含真实账号或密钥，禁止提交 Git。

# API 监听配置，使用 python -m app 启动时生效。端口范围为 1–65535。
API_HOST=127.0.0.1
API_PORT=4444
API_RELOAD=true
# 允许的前端来源（JSON 数组）；前端改端口后同步修改，多个来源可一并列出。
CORS_ORIGINS=["http://localhost:5173"]

# 基础服务连接：PostgreSQL 保存文档/任务/版本元数据，Redis 用于 API 与解析 Worker 之间的任务队列。
DATABASE_URL=postgresql+psycopg://knowledge:knowledge@localhost:5432/knowledge
REDIS_URL=redis://localhost:6379/0

# MinIO/S3 对象存储：保存原文件、解析器原始结果和标准化产物。生产环境使用专用最小权限账号、HTTPS，密钥仅保存于 `.env` 或密钥管理服务。
# 本地直启为 localhost；Docker 内会将服务地址覆盖为 minio:9000。
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=documents

# 云端视觉模型：Key 仅写入未提交的 .env 或当前终端环境变量，不能填在本示例文件中。
DOCUMENT_PARSER=deepseek_vision
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 官方稳定模型名；实际由 DeepSeek 路由至支持 Vision 的 DeepSeek-V4.1-Flash。
DEEPSEEK_VISION_MODEL=deepseek-flash
# 单次文档允许发送给模型的最大页数，防止误上传超长文档产生高额费用。
DEEPSEEK_MAX_PAGES=30
DEEPSEEK_MAX_OUTPUT_TOKENS=8192

# 可切换的本地 MinerU 备用路径；将 DOCUMENT_PARSER 改为 mineru 时使用。
MINERU_BASE_URL=http://localhost:8080

# 上传限制：单文件最大字节数，52428800 即 50 MiB。
MAX_UPLOAD_BYTES=52428800
